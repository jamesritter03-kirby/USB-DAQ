<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:UsbDaq.App.ViewModels"
        xmlns:controls="using:UsbDaq.App.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UsbDaq.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/AppIcon.png"
        Width="1280"
        Height="820"
        Title="USB DAQ — Pressure Monitor">
    <Window.Resources>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#1A2B3C" />
        <SolidColorBrush x:Key="ToolbarTextBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="GraphBackBrush" Color="#0D1B2A" />
        <SolidColorBrush x:Key="AlarmBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="ConnectedBrush" Color="#10B981" />
        <SolidColorBrush x:Key="MutedBrush" Color="#475569" />
    </Window.Resources>

    <Grid RowDefinitions="48,*,26">

        <!-- ══════════════════ TOP TOOLBAR ══════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0">

                <!-- Left: title + sensor info -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="USB Pressure DAQ" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource ToolbarTextBrush}"/>
                    <Border Width="1" Height="16" Background="#334155" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SensorSummary}" FontSize="11"
                               Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: live indicator + alarm badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource ConnectedBrush}"
                             IsVisible="{Binding IsAcquiring}"/>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource MutedBrush}"
                             IsVisible="{Binding IsNotAcquiring}"/>
                    <TextBlock Text="{Binding AcquisitionStatusLabel}" FontSize="12"
                               Foreground="{StaticResource ToolbarTextBrush}" VerticalAlignment="Center"/>
                    <Border Background="#7F1D1D" CornerRadius="4" Padding="8,2"
                            IsVisible="{Binding IsAlarmActive}">
                        <TextBlock Text="⚠ ALARM" Foreground="#FCA5A5" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Right: action buttons + theme -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="▶  Start" Click="StartButton_OnClick"
                            IsEnabled="{Binding CanStartAcquisition}" Padding="14,5"/>
                    <Button Content="■  Stop" Click="StopButton_OnClick"
                            IsEnabled="{Binding CanStopAcquisition}" Padding="14,5"/>
                    <ToggleButton Content="⏺  Record" IsChecked="{Binding IsRecording}" Padding="14,5"/>
                    <!-- Version/update badge — turns to ⬆ vX.Y.Z when an update is available -->
                    <Button Content="{Binding VersionLabel}" Click="CheckForUpdates_Click"
                            Padding="12,5" FontSize="12" VerticalAlignment="Center"
                            ToolTip.Tip="Click to check for updates"/>
                    <!-- Profiles flyout -->
                    <Button Content="Profiles ▾" Padding="14,5">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Spacing="5" Margin="4" Width="240">
                                    <TextBlock Text="PROFILES" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBox Grid.Column="0" Text="{Binding NewProfileName}"
                                                 FontSize="12" Watermark="Profile name…"/>
                                        <Button Grid.Column="1" Content="Save" Click="SaveProfile_Click"
                                                Padding="10,5" FontSize="12"/>
                                    </Grid>
                                    <Separator Margin="0,2"/>
                                    <ListBox ItemsSource="{Binding SavedProfileNames}" MaxHeight="200"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12"/>
                                                    <Button Grid.Column="1" Content="Load"
                                                            Click="LoadProfileItem_Click"
                                                            Padding="6,3" FontSize="11"/>
                                                    <Button Grid.Column="2" Content="✕"
                                                            Click="DeleteProfileItem_Click"
                                                            Width="24" Padding="2" FontSize="11"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <ComboBox ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ThemeMode}"
                              Width="110" SelectionChanged="ThemeCombo_OnSelectionChanged"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="310,*">

            <!-- ─── LEFT SIDEBAR ─── -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">

                    <!-- Device selector section -->
                    <Border Grid.Row="0" Padding="10,8"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableDevices}"
                                          SelectedItem="{Binding SelectedAvailableDevice}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="⟳" Click="RefreshButton_OnClick"
                                        ToolTip.Tip="Refresh device list" Width="32" Padding="4,5"
                                        FontSize="14"/>
                                <Button Grid.Column="2" Content="+ Add" Click="AddChannelButton_OnClick"
                                        IsEnabled="{Binding CanAddChannel}" Padding="10,5"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Button Grid.Column="0" Content="Connect All"
                                        Click="ConnectAllButton_OnClick" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Disc. All"
                                        Click="DisconnectAllButton_OnClick" Padding="8,5"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Channel list header -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="10,6,10,2">
                        <TextBlock Grid.Column="0" Text="CHANNELS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Clear All" Click="ClearButton_OnClick"
                                Padding="6,2" FontSize="11"/>
                    </Grid>

                    <!-- Channel cards -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding Channels}"
                             SelectedItem="{Binding SelectedChannel}"
                             Padding="6,4,6,4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem" x:DataType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" ClipToBounds="True" MinHeight="86">
                                    <Panel>
                                        <!-- Alarm tint overlay -->
                                        <Border Background="#20EF4444" CornerRadius="6"
                                                IsVisible="{Binding IsAlarm}"/>
                                        <Grid ColumnDefinitions="5,*,Auto">
                                            <!-- Color strip -->
                                            <Rectangle Grid.Column="0" Fill="{Binding TraceBrush}"/>
                                            <!-- Main content -->
                                            <StackPanel Grid.Column="1" Margin="10,8,4,8" Spacing="3">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}"
                                                              VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SignalName}"
                                                             FontWeight="SemiBold" FontSize="12"
                                                             BorderThickness="0" Background="Transparent"
                                                             Padding="2,0" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="{Binding CurrentPressureText}"
                                                           FontSize="21" FontWeight="Bold"/>
                                                <Grid ColumnDefinitions="*,*,*">
                                                    <StackPanel Grid.Column="0" Spacing="1">
                                                        <TextBlock Text="MIN" FontSize="9"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                        <TextBlock Text="{Binding MinObserved, StringFormat={}{0:F0}}" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock Text="AVG" FontSize="9"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                        <TextBlock Text="{Binding AverageObserved, StringFormat={}{0:F0}}" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="1">
                                                        <TextBlock Text="MAX" FontSize="9"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                        <TextBlock Text="{Binding MaxObserved, StringFormat={}{0:F0}}" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Status}" FontSize="10"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                            </StackPanel>
                                            <!-- Actions -->
                                            <StackPanel Grid.Column="2" Margin="4,8,8,8" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <Button Content="Connect" Click="CardConnect_OnClick"
                                                        FontSize="11" Padding="6,3"
                                                        IsVisible="{Binding IsNotConnected}"/>
                                                <Button Content="Disc." Click="CardDisconnect_OnClick"
                                                        FontSize="11" Padding="6,3"
                                                        IsVisible="{Binding IsConnected}"/>
                                                <Button Content="⚙" Click="CardConfigure_OnClick"
                                                        FontSize="13" Width="26" Height="26" Padding="2"
                                                        ToolTip.Tip="Configure channel"/>
                                                <Button Content="✕" Click="CardRemove_OnClick"
                                                        FontSize="12" Width="26" Height="26" Padding="2"
                                                        ToolTip.Tip="Remove channel"/>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{StaticResource AlarmBrush}"
                                                         IsVisible="{Binding IsAlarm}"
                                                         ToolTip.Tip="Channel in alarm"/>
                                            </StackPanel>
                                        </Grid>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Settings & stats footer (compact) -->
                    <Border Grid.Row="3" Padding="10,10"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="Fleet Average"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding OverallPressureText}"
                                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                            <Button Content="⚙  Settings" Click="OpenSettings_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="10,7"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ─── RIGHT: GRAPH AREA ─── -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

                <!-- Graph toolbar -->
                <Border Grid.Row="0" Padding="10,6"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="Zoom:" VerticalAlignment="Center" FontSize="12"/>
                        <Button Grid.Column="1" Content="10s" Click="Zoom10sButton_OnClick"
                                Padding="10,4" FontSize="12"/>
                        <Button Grid.Column="2" Content="30s" Click="Zoom30sButton_OnClick"
                                Padding="10,4" FontSize="12"/>
                        <Button Grid.Column="3" Content="1 min" Click="Zoom1mButton_OnClick"
                                Padding="10,4" FontSize="12"/>
                        <Button Grid.Column="4" Content="5 min" Click="Zoom5mButton_OnClick"
                                Padding="10,4" FontSize="12"/>
                        <Button Grid.Column="5" Content="All" Click="ResetZoomButton_OnClick"
                                Padding="10,4" FontSize="12"/>

                        <!-- + / - zoom -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Border Width="1" Height="18"
                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    VerticalAlignment="Center" Margin="4,0"/>
                            <Button Content="+" Click="ZoomInButton_OnClick" Width="28" Padding="4,4" FontSize="14"/>
                            <Button Content="−" Click="ZoomOutButton_OnClick" Width="28" Padding="4,4" FontSize="14"/>
                        </StackPanel>

                        <!-- Mode and view options -->
                        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding GraphModes}" SelectedItem="{Binding GraphMode}"
                                      Width="160" FontSize="12"/>
                            <CheckBox Content="Auto Follow" IsChecked="{Binding GraphAutoFollow}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <CheckBox Content="Cursors" IsChecked="{Binding ShowCursors}" FontSize="12"/>
                            <CheckBox Content="Snap" IsChecked="{Binding CursorSnapToData}" FontSize="12"
                                      ToolTip.Tip="Snap cursors to nearest data sample"/>
                            <CheckBox Content="Track" IsChecked="{Binding CursorFollowsData}" FontSize="12"
                                      ToolTip.Tip="Cursors move with the plot (checked) or stay fixed on the x-axis (unchecked)"/>
                            <ToggleButton Content="Pair" IsChecked="{Binding MoveCursorPair}" FontSize="12" Padding="8,2"
                                      ToolTip.Tip="When on, drag anywhere on the plot to move both cursors together"/>
                            <CheckBox Content="Markers" IsChecked="{Binding ShowPointMarkers}" FontSize="12"/>
                            <CheckBox Content="Legend" IsChecked="{Binding ShowLegend}" FontSize="12"/>
                            <CheckBox Content="Alarm Lines" IsChecked="{Binding ShowAlarmLines}" FontSize="12"/>
                            <CheckBox Content="Stacked" IsChecked="{Binding StackedPlots}" FontSize="12"/>
                        </StackPanel>

                        <!-- Export flyout button -->
                        <Button Grid.Column="10" Content="Export ▾" Padding="10,4" FontSize="12"
                                VerticalAlignment="Center">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Spacing="3" Margin="4" MinWidth="240">
                                        <Button Content="Copy Data to Clipboard (CSV)"
                                                Click="ExportClipboard_Click" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="10,5"/>
                                        <Button Content="Save Graph as PNG…"
                                                Click="ExportPng_Click" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="10,5"/>
                                        <Separator Margin="0,2"/>
                                        <Button Content="Export Data as CSV…"
                                                Click="ExportCsv_Click" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="10,5"/>
                                        <Button Content="Export Data as JSON…"
                                                Click="ExportJson_Click" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="10,5"/>
                                        <Button Content="Export Data as Excel (.xlsx)…"
                                                Click="ExportExcel_Click" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="10,5"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>

                <!-- Graph canvas -->
                <Border Grid.Row="1" Background="{StaticResource GraphBackBrush}">
                    <controls:MultiDeviceGraphControl Name="GraphControl"
                                                      Series="{Binding Channels}"
                                                      MinValue="{Binding MinPressurePsig}"
                                                      MaxValue="{Binding MaxPressurePsig}"
                                                      SampleIntervalMs="{Binding SampleIntervalMs}"
                                                      GraphMode="{Binding GraphMode}"
                                                      GraphAutoFollow="{Binding GraphAutoFollow}"
                                                      ShowPointMarkers="{Binding ShowPointMarkers}"
                                                      ShowLegend="{Binding ShowLegend}"
                                                      ShowCursors="{Binding ShowCursors}"
                                                      ShowAlarmLines="{Binding ShowAlarmLines}"
                                                      StackedPlots="{Binding StackedPlots}"
                                                      CursorSnapToData="{Binding CursorSnapToData}"
                                                      CursorFollowsData="{Binding CursorFollowsData}"
                                                      MoveCursorPair="{Binding MoveCursorPair}"
                                                      LowAlarmValue="{Binding LowAlarmPsig}"
                                                      HighAlarmValue="{Binding HighAlarmPsig}"
                                                      IsAcquiring="{Binding IsAcquiring}"/>
                </Border>

                <!-- Scrollbar -->
                <ScrollBar Grid.Row="2"
                           Orientation="Horizontal"
                           Minimum="0"
                           Maximum="1"
                           Value="{Binding StartFraction, ElementName=GraphControl}"
                           ViewportSize="{Binding WindowFraction, ElementName=GraphControl}"/>
            </Grid>
        </Grid>

        <!-- ══════════════════ STATUS BAR ══════════════════ -->
        <Border Grid.Row="2" Padding="12,4"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center"/>
        </Border>

    </Grid>
</Window>